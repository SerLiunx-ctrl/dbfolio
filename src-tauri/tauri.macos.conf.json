{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "dragDropEnabled": true,
        "title": "DBFolio",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "transparent": false,
        "decorations": false,
        "shadow": true,
        "windowEffects": null
      }
    ]
  },
  "bundle": {
    "targets": [
      "app",
      "dmg"
    ],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": true
    }
  }
}
